# Entorno público: development | staging | production | test
NEXT_PUBLIC_PLIEGUE_APP_ENV=development

# Feature flags públicas. Solo aceptan true/false.
NEXT_PUBLIC_FEATURE_DRIVE=false
NEXT_PUBLIC_FEATURE_LOCAL_FILES=true
NEXT_PUBLIC_FEATURE_AI_PANEL=true

# Supabase: cuenta opcional y sincronización. Sin estas dos, Pliegue funciona solo en local.
# La clave publicable (sb_publishable_…) es pública por diseño; la service_role nunca va aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nunca añadas claves de proveedores con el prefijo NEXT_PUBLIC_.
# Los secretos se integrarán mediante la bóveda segura de la tarea 02.5.
