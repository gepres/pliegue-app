# Entorno público: development | staging | production | test
NEXT_PUBLIC_PLIEGUE_APP_ENV=development

# Feature flags públicas. Solo aceptan true/false.
NEXT_PUBLIC_FEATURE_DRIVE=true
NEXT_PUBLIC_FEATURE_LOCAL_FILES=true
NEXT_PUBLIC_FEATURE_AI_PANEL=true

# Supabase: cuenta opcional y sincronización. Sin estas dos, Pliegue funciona solo en local.
# La clave publicable (sb_publishable_…) es pública por diseño; la service_role nunca va aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Drive: sin las tres, Drive no aparece. Son públicas por diseño (ver docs/google-drive.md);
# la clave de API debe estar restringida a la Picker API y a los dominios de Pliegue.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=

# Biblioteca general (/biblioteca/general): SOLO DE SERVIDOR, nunca con NEXT_PUBLIC_.
# La clave secreta de Supabase (sb_secret_… o la antigua service_role) canjea los códigos; la
# carpeta es la de Drive compartida como «cualquiera con el enlace». La clave de API de Google de
# arriba debe permitir también la Google Drive API. Pasos en docs/biblioteca-general.md.
SUPABASE_SECRET_KEY=
PLIEGUE_GENERAL_FOLDER_ID=
# Opcional: firma las sesiones de la biblioteca general. Si falta, se usa la clave secreta.
PLIEGUE_LIBRARY_SECRET=

# Nunca añadas claves de proveedores con el prefijo NEXT_PUBLIC_.
# Los secretos se integrarán mediante la bóveda segura de la tarea 02.5.
